; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sort Streak"
config/version="1.0.10"
run/main_scene="uid://b7eqvkjrlbffh"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0.36862746, 0.7411765, 0.99215686, 1)
boot_splash/image="res://assets/app/boot_logo.png"
config/icon="uid://cpt1emwojrh3y"
boot_splash/minimum_display_time=1
config/version_code=381

[autoload]

UserState="*res://scripts/data/user_state/user_state.gd"
AudioManager="*res://scripts/capability/audio/audio_manager.tscn"
HapticManager="*res://scripts/capability/haptic/haptic_manager.tscn"
SceneManager="*res://scripts/frame/scene/scene_manager.gd"
CheatBus="*res://scripts/debug/cheat_manager/cheat_bus.gd"
NativeUtilManager="*res://scripts/capability/native_util/native_util_manager.gd"
SessionManager="*res://scripts/capability/session/session_manager.gd"
DebugApiServerManager="*res://scripts/debug/debug_api_server_manager.gd"
DbManager="*res://scripts/common/db/db_manager.gd"
LevelManager="*res://scripts/data/level_data/level_manager.gd"
UniKit="*res://addons/unikit/scripts/unikit.gd"
AdManager="*res://scripts/data/ads/ad_manager.gd"
AuthManager="*res://scripts/data/auth/auth_manager.gd"
UniKitManager="*res://scripts/data/unikit/unikit_manager.gd"
Tracker="*res://scripts/common/tracker/tracker.gd"
GrtManager="*res://scripts/data/grt/grt_manager.gd"
ABManager="*res://scripts/frame/abtest/ab_manager.gd"
RankManager="*res://scripts/gameplay/rank/rank_manager.gd"

[debug]

settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=1080
window/size/viewport_height=2340
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=0

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[editor_plugins]

enabled=PackedStringArray("res://addons/fly_trail/plugin.cfg", "res://addons/godot_package_manager/plugin.cfg", "res://addons/ios_build_helper/plugin.cfg", "res://addons/unikit/plugin.cfg", "res://addons/ios_lifecycle_compat/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/default_font.tres"

[internationalization]

rendering/root_node_layout_direction=1.0
locale/translations=PackedStringArray("res://assets/localization/translations.zh_CN.translation", "res://assets/localization/translations.en.translation", "res://assets/localization/translations.pt_BR.translation", "res://assets/localization/translations.id.translation", "res://assets/localization/translations.fil.translation", "res://assets/localization/translations.es.translation", "res://assets/localization/translations.ru.translation", "res://assets/localization/translations.de.translation", "res://assets/localization/translations.ja.translation", "res://assets/localization/translations.fr.translation", "res://assets/localization/translations.ko.translation", "res://assets/localization/translations.it.translation", "res://assets/localization/translations.pl.translation", "res://assets/localization/translations.tr.translation", "res://assets/localization/translations.uk.translation", "res://assets/localization/translations.zh_TW.translation", "res://assets/localization/translations.th.translation", "res://assets/localization/translations.ms.translation", "res://assets/localization/translations.vi.translation", "res://assets/localization/translations.ro.translation", "res://assets/localization/translations.nl.translation", "res://assets/localization/translations.nb.translation", "res://assets/localization/translations.fi.translation", "res://assets/localization/translations.el.translation", "res://assets/localization/translations.sv.translation", "res://assets/localization/translations.hu.translation", "res://assets/localization/translations.bn.translation", "res://assets/localization/translations.ta.translation", "res://assets/localization/translations.ur.translation")
locale/test="en"

[physics]

3d/physics_engine="Jolt Physics"
2d/solver/solver_iterations=32
2d/solver/contact_max_allowed_penetration=3.0
2d/solver/default_contact_bias=0.3

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
viewport/transparent_background=true
