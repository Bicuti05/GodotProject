[connection signal="button_up" from="FigmaStage/ContinueRig/ContinueButton" to="." method="_on_ok_up"]
[connection signal="pressed" from="FigmaStage/ContinueRig/ContinueButton" to="." method="_on_continue_pressed"]
[connection signal="opening_sound_cued" from="FigmaStage/EarnedCoinsOverlay/Card/Gift" to="." method="_on_gift_opening_sound_cued"]
[connection signal="reward_revealed" from="FigmaStage/EarnedCoinsOverlay/Card/Gift" to="." method="_on_gift_reward_revealed"]
[connection signal="pressed" from="FigmaStage/EarnedCoinsOverlay/Hit" to="." method="dismiss_reward"]
