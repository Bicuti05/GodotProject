[sub_resource type="Shader" id="range_shader"]
code = "shader_type canvas_item;
varying float local_y;
void vertex() { local_y = VERTEX.y; }
void fragment() {
vec4 src = COLOR;
vec3 ramp = mix(vec3(0.9960784, 1.0, 0.8431373), vec3(1.0, 0.9098039, 0.4627451), clamp(local_y / 48.0, 0.0, 1.0));
float fill = smoothstep(0.65, 0.90, max(src.r, max(src.g, src.b)));
COLOR = vec4(mix(src.rgb, ramp, fill), src.a);
}"

