[sub_resource type="Shader" id="SunCoreShader"]
code = "shader_type canvas_item;
render_mode blend_mix, unshaded;

varying vec4 particle_tint;

void vertex() {
    particle_tint = COLOR;
}

void fragment() {
    vec4 source = texture(TEXTURE, UV);
    float core_alpha = smoothstep(0.25, 0.75, source.a);
    COLOR = vec4(source.rgb * particle_tint.rgb, core_alpha * particle_tint.a);
}
"

