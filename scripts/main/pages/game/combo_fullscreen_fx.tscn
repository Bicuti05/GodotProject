[sub_resource type="Shader" id="EdgeLightBandShader"]
code = "shader_type canvas_item;
render_mode blend_premul_alpha;

uniform bool right_edge = false;
uniform float band_brightness = 1.38;
uniform float end_opacity = 0.0;
varying vec4 band_tint;

float light_profile(float inward_distance, float vertical_distance) {
    float inward_opacity = 1.0 - smoothstep(0.0, 1.0, inward_distance);
    float vertical_opacity = mix(1.0, end_opacity, smoothstep(0.0, 1.0, vertical_distance));
    return inward_opacity * vertical_opacity;
}

void vertex() {
    band_tint = COLOR;
}

void fragment() {
    float cross_band_uv = right_edge ? UV.x : 1.0 - UV.x;
    vec2 band_uv = vec2(cross_band_uv, 0.5);
    vec4 band_sample = texture(TEXTURE, band_uv);
    float inward_distance = right_edge ? 1.0 - UV.x : UV.x;
    float vertical_distance = abs(UV.y * 2.0 - 1.0);
    float band_profile = light_profile(inward_distance, vertical_distance);
    float inward_profile = light_profile(inward_distance, 0.0);
    float core_profile = inward_profile * inward_profile * inward_profile;
    float amplitude = band_sample.a * band_tint.a * band_profile * band_brightness;
    float tint_opacity = amplitude * 0.68;
    vec3 halo_tint = mix(band_tint.rgb, vec3(1.0, 0.98, 0.74), 0.3);
    vec3 core_tint = mix(halo_tint, vec3(1.0, 0.995, 0.9), 0.4);
    vec3 light_color = mix(halo_tint, core_tint, core_profile);
    float edge_energy = tint_opacity * core_profile * 0.1;
    vec3 light_rgb = band_sample.rgb * (light_color * tint_opacity + core_tint * edge_energy);
    COLOR = vec4(light_rgb, tint_opacity);
}
"

