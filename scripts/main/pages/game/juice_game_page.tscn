[sub_resource type="Shader" id="EndlessWarningShader"]
code = "shader_type canvas_item;
uniform vec2 viewport_size = vec2(1080.0, 2340.0);
uniform float strength = 0.0;
void fragment() {
    vec2 edge_distance = min(UV, vec2(1.0) - UV) * viewport_size;
    float width = min(viewport_size.x, viewport_size.y) * 0.07;
    float edge = 1.0 - smoothstep(0.0, width, min(edge_distance.x, edge_distance.y));
    COLOR = vec4(0.92, 0.14, 0.18, edge * edge * strength);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vrumk"]
resource_local_to_scene = true
shader = SubResource("EndlessWarningShader")
shader_parameter/viewport_size = null
shader_parameter/strength = null

