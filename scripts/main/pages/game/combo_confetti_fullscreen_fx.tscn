[sub_resource type="Shader" id="SoftPinkGlowShader"]
code = "shader_type canvas_item;
render_mode blend_premul_alpha;

uniform vec4 glow_color : source_color = vec4(1.0, 0.7817472, 0.7373568, 0.78);
uniform float glow_intensity = 16.741617408;
uniform float glow_brightness = 1.2;
uniform bool right_edge = false;
varying vec4 glow_tint;

void vertex() {
    glow_tint = COLOR;
}

void fragment() {
    vec4 glow_sample = texture(TEXTURE, UV);
    float shade = max(glow_sample.r, max(glow_sample.g, glow_sample.b));
    float inward_distance = clamp(right_edge ? 1.0 - UV.x : UV.x, 0.0, 1.0);
    float inward_fade = 1.0 - inward_distance * inward_distance * inward_distance * (inward_distance * (inward_distance * 6.0 - 15.0) + 10.0);
    float vertical_distance = clamp(abs(UV.y * 2.0 - 1.0), 0.0, 1.0);
    float vertical_fade = 1.0 - vertical_distance * vertical_distance * vertical_distance * (vertical_distance * (vertical_distance * 6.0 - 15.0) + 10.0);
    float glow_opacity = clamp(glow_sample.a * glow_color.a * glow_intensity, 0.0, 1.0) * inward_fade;
    float final_opacity = glow_opacity * vertical_fade * glow_tint.a;
    vec3 light_rgb = glow_color.rgb * shade * glow_tint.rgb * final_opacity * glow_brightness;
    COLOR = vec4(light_rgb, final_opacity);
}
"

