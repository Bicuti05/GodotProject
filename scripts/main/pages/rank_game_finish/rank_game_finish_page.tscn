[sub_resource type="Shader" id="title_shader"]
code = "shader_type canvas_item;
varying float local_y;
uniform float ink_top = 38.0;
uniform float ink_bottom = 138.0;
void vertex() { local_y = VERTEX.y; }
void fragment() {
	vec4 src = COLOR;
	float t = clamp((local_y - ink_top) / max(ink_bottom - ink_top, 1.0), 0.0, 1.0);
	vec3 outline = mix(vec3(0.1254902, 0.4235294, 0.3254902), vec3(0.1127726, 0.5913461, 0.3359112), t);
	float fill = smoothstep(0.65, 0.90, max(src.r, max(src.g, src.b)));
	COLOR = vec4(mix(outline, src.rgb, fill), src.a);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_inh26"]
