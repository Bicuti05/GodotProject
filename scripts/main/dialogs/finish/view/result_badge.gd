const STAR_TRACKS: Array[Dictionary] = [SPARK1_TRACKS, SPARK2_TRACKS, SPARK3_TRACKS, 
	IDLE1_TRACKS, IDLE2_TRACKS, IDLE3_TRACKS, IDLE4_TRACKS, IDLE5_TRACKS, IDLE6_TRACKS]

@export var texture: Texture2D
@onready var _content: Control = $Content
@onready var _rating: TextureRect = $Content / Rating
@onready var _rise: Control = $Content / Rise
@onready var _sweep: TextureRect = $Content / Rise / Sweep
@onready var _stars: Array[Control] = [
	$Content / Rise / Spark1, $Content / Rise / Spark2, $Content / Rise / Spark3, 
	$Content / Rise / Idle1, $Content / Rise / Idle2, $Content / Rise / Idle3, 
	$Content / Rise / Idle4, $Content / Rise / Idle5, $Content / Rise / Idle6]
var _is_rise: bool = false
var _rise_time: float = 0.0
var _stamp_complete: bool = false


func _ready() -> void :
	_content.scale = size / DESIGN_SIZE
	pivot_offset = size * 0.5
	reset()


func configure(image: Texture2D, is_rise: bool) -> void :
	texture = image
	_is_rise = is_rise
	_rating.texture = image
	_rating.visible = not is_rise
	_rise.visible = is_rise
	reset()



func append_stamp(tween: Tween, delay: float, on_impact: Callable = Callable()) -> void :
	if texture == null:
		return
	tween.tween_callback(show).set_delay(delay)
	tween.tween_property(self, "modulate:a", 1.0, STAMP_DURATION * 0.5)\
	.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT).set_delay(delay)
	tween.tween_property(self, "scale", Vector2.ONE * STAMP_DIP_SCALE, STAMP_PRESS_DURATION)\
	.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT).set_delay(delay)
	if on_impact.is_valid():
		tween.tween_callback(on_impact).set_delay(delay + STAMP_PRESS_DURATION)
	tween.tween_property(self, "scale", Vector2.ONE, STAMP_DURATION - STAMP_PRESS_DURATION)\
	.from(Vector2.ONE * STAMP_DIP_SCALE).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)\
	.set_delay(delay + STAMP_PRESS_DURATION)
	tween.tween_callback(_on_stamp_finished).set_delay(delay + STAMP_DURATION)


func _on_stamp_finished() -> void :
	_stamp_complete = true
	if _is_rise:
		_apply_rise_time(0.0)
		set_process(true)


func _process(delta: float) -> void :
	_rise_time = fmod(_rise_time + delta, RISE_DURATION)
	_apply_rise_time(_rise_time)


func _apply_rise_time(seconds: float) -> void :
	var phase: float = fposmod(seconds, RISE_DURATION)
	var material: ShaderMaterial = _sweep.material as ShaderMaterial
	material.set_shader_parameter("sweep_offset", _sample_track(SWEEP_TRACKS.translate, phase))
	_sweep.modulate.a = _sample_track(SWEEP_TRACKS.opacity, phase)
	for i: int in _stars.size():
		_stars[i].modulate.a = _sample_track(STAR_TRACKS[i].opacity, phase)
		_stars[i].scale = Vector2.ONE * _sample_track(STAR_TRACKS[i].scale, phase)



static func _sample_track(keys: Array, seconds: float) -> float:
	var low: int = 0
	var high: int = keys.size() - 1
	while low + 1 < high:
		var middle: int = (low + high) / 2
		if float(keys[middle][0]) <= seconds:
			low = middle
		else:
			high = middle
	var start: Array = keys[low]
	var end: Array = keys[high]
	var progress: float = clampf((seconds - float(start[0])) / (float(end[0]) - float(start[0])), 0.0, 1.0)
	match int(start[2]):
		1: progress = _css_bezier(progress, Vector2(0.0, 0.0), Vector2(0.58, 1.0))
		2: progress = _css_bezier(progress, Vector2(0.42, 0.0), Vector2(0.58, 1.0))
		3: progress = 1.0 if progress >= 1.0 else 0.0
	return lerpf(float(start[1]), float(end[1]), progress)


static func _css_bezier(progress: float, first: Vector2, second: Vector2) -> float:
	var low: float = 0.0
	var high: float = 1.0
	for iteration: int in 16:
		var t: float = (low + high) * 0.5
		var inverse: float = 1.0 - t
		var x: float = 3.0 * inverse * inverse * t * first.x + 3.0 * inverse * t * t * second.x + t * t * t
		if x < progress:
			low = t
		else:
			high = t
	var t: float = (low + high) * 0.5
	var inverse: float = 1.0 - t
	return 3.0 * inverse * inverse * t * first.y + 3.0 * inverse * t * t * second.y + t * t * t


func warm_rise() -> void :
	_rating.hide()
	_rise.show()
	show()
	scale = Vector2.ONE
	modulate.a = 1.0
	_apply_rise_time(1.2)

	_sweep.modulate.a = 0.82
	for star: Control in _stars:
		star.modulate.a = 1.0
		star.scale = Vector2.ONE


func reset() -> void :
	set_process(false)
	_rise_time = 0.0
	_stamp_complete = false
	hide()
	scale = Vector2.ONE * STAMP_FROM_SCALE
	modulate.a = 0.0
	_apply_rise_time(0.0)
