[sub_resource type="Shader" id="outline_shader"]
code = "shader_type canvas_item;
render_mode unshaded;

varying vec4 tint;

void vertex() {
	tint = COLOR;
}

void fragment() {
	vec4 face = texture(TEXTURE, UV);
	// 保留原按钮贴图的白色边框，剔除彩色填充和暗色底影。
	float white = smoothstep(0.9, 0.98, min(face.r, min(face.g, face.b)));
	COLOR = vec4(vec3(1.0), face.a * white) * tint;
}
"

